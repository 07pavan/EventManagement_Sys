# ============================================================
# GoAttend — Environment Variable Reference
# ============================================================
# Copy this file to .env and fill in real values for local dev.
# For Render production, set these in the Render dashboard:
#   Dashboard → Your Service → Environment → Add Environment Variable
#
# DO NOT commit .env to git — it is in .gitignore.
# ============================================================

# ── Django Core ──────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# Set to False in production. Render sets this automatically
# via render.yaml (DEBUG=False).
DEBUG=True

# Comma-separated. In production: your-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (Supabase) ───────────────────────────────────────
# Leave empty to use SQLite locally.
# Production (Supabase): paste your full connection string.
#
# HOW TO GET YOUR SUPABASE CONNECTION STRING:
#   1. Go to https://supabase.com and sign in / create a project
#   2. Navigate to Project Settings → Database
#   3. Under "Connection string", select "URI" tab
#   4. Copy the URI (it looks like the format below)
#   5. Replace [YOUR-PASSWORD] with your actual DB password
#
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Note:   Supabase connection strings do NOT need ?sslmode=require appended manually.
#         The settings.py handles SSL detection automatically.
DATABASE_URL=

# ── Cloudinary (Media Storage) ────────────────────────────────
# Leave empty to store uploads locally in media/ folder.
# Production: get this from Cloudinary Dashboard → API Keys.
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# ── CORS / CSRF ───────────────────────────────────────────────
# Your Vercel frontend URL(s) — comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# For production, add your Render backend URL too:
# CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,https://your-api.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Frontend (config.js) ─────────────────────────────────────
# This is NOT used by Django — it drives the Vercel buildCommand.
# Vercel reads RENDER_API_URL and auto-generates frontend/config.js at build time.
# Local:      window.GOATTEND_API = 'http://127.0.0.1:8001/api'
# Production: window.GOATTEND_API = 'https://your-api.onrender.com/api'
RENDER_API_URL=https://your-render-service.onrender.com

# ── Resend SMTP (Production Email) ───────────────────────────
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=your_resend_api_key_here (starts with re_...)
# DEFAULT_FROM_EMAIL=GoAttend <noreply@yourdomain.com>
# FRONTEND_URL=https://your-app.vercel.app
